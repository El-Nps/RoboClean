<?xml version="1.0"?>
<sdf version="1.8">
  <world name="floorplan_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="house_layout">
      <static>true</static>

      <!-- Outer Walls -->
      <link name="north_wall">
        <pose>0 5 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
        </visual>
      </link>
      <link name="south_wall">
        <pose>0 -5 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
        </visual>
      </link>
      <link name="east_wall">
        <pose>5 0 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
        </visual>
      </link>
      <link name="west_wall">
        <pose>-5 0 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- Inner Walls -->
      <link name="inner_wall_vertical">
        <pose>0 2.5 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>0.2 5 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.2 5 1</size>
            </box>
          </geometry>
        </visual>
      </link>
      <link name="inner_wall_horizontal">
        <pose>3.5 0 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>3 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>3 0.2 1</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- Room Obstacles -->
      <link name="obstacle_cylinder">
        <pose>-2.5 2 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
      <link name="obstacle_box_1">
        <pose>2.5 3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>1 2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>1 2 1</size>
            </box>
          </geometry>
        </visual>
      </link>
      <link name="obstacle_box_2">
        <pose>2.5 -2.5 0.5 0 0 0</pose>
        <collision name="c">
          <geometry>
            <box>
              <size>1.5 1.5 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>1.5 1.5 1</size>
            </box>
          </geometry>
        </visual>
      </link>

    </model>
  </world>
</sdf>