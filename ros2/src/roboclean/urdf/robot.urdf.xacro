<?xml version="1.0"?>
<robot name="vacuum_bot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="chassis_height" value="0.08"/>
  <xacro:property name="wheel_radius" value="0.0375"/>
  <xacro:property name="clearance" value="0.015"/> 

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${m}" />
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy = "0" ixz = "0" iyy="${(m/12) * (3*r*r + h*h)}" iyz = "0" izz="${(m/2) * (r*r)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${m}" />
      <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0" ixz="0" iyy="${(m/12) * (x*x + z*z)}" iyz="0" izz="${(m/12) * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0" iyy="${(2/5) * m * (r*r)}" iyz="0.0" izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"></link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.17" length="${chassis_height}"/>
      </geometry>
      <material name="black">
          <color rgba="0 0 0 1"/>
      </material>
    </visual>
  
    <collision>
      <geometry>
        <cylinder radius="0.17" length="${chassis_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia m="5.0" r="0.17" h="${chassis_height}"/>
  </link>
  
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="0.02"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="0.02"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.12875 -${chassis_height/2 + clearance - wheel_radius}" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="0.02"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="0.02"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.12875 -${chassis_height/2 + clearance - wheel_radius}" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Caster Wheel -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${clearance/2}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
         <sphere radius="${clearance/2}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="0.1" r="${clearance/2}"/>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.1 0 -${chassis_height/2 + clearance/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  
  <!-- Rear Caster Wheel -->
  <link name="rear_caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${clearance/2}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
         <sphere radius="${clearance/2}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="0.1" r="${clearance/2}"/>
  </link>

  <joint name="rear_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_wheel"/>
    <origin xyz="-0.1 0 -${chassis_height/2 + clearance/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="rear_caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Gazebo Sim (Harmonic) Diff Drive Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.2575</wheel_separation>
      <wheel_radius>0.0375</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    
    <!-- Joint State Publisher for wheel TFs -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <link name="laser_frame">
    <visual>
        <geometry>
            <cylinder radius="0.05" length="0.04"/>
        </geometry>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.05" length="0.04"/>
        </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.05" h="0.04"/>
  </link>
  
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.135" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Gazebo Sim Laser Sensor -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <frame_id>laser_frame</frame_id>
      <ignition_frame_id>laser_frame</ignition_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.283185</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.150000</min>
          <max>12.0</max>
          <resolution>0.005</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>


</robot>
